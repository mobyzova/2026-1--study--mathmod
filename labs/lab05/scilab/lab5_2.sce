// Модель "хищник-жертва" - Вариант 60
// Стационарное состояние системы

a = 0.43;
b = 0.061;
c = 0.47;
d = 0.059;

// Стационарное состояние: x0 = c/d, y0 = a/b
x0_stat = c / d;
y0_stat = a / b;

printf("Стационарное состояние системы:\n");
printf("x0 = %.2f (численность хищников)\n", x0_stat);
printf("y0 = %.2f (численность жертв)\n", y0_stat);

function dx = syst2(t, xy)
    dx(1) = -a*xy(1) + b*xy(1)*xy(2);
    dx(2) = c*xy(2) - d*xy(1)*xy(2);
endfunction

t0 = 0;
xy0 = [x0_stat; y0_stat];
t = [0:0.1:100];

xy = ode(xy0, t0, t, syst2);

// График 1: Стационарное состояние x(t) и y(t)
figure(1);
plot(t, xy(1,:), 'r-', t, xy(2,:), 'g-');
xlabel('Время t');
ylabel('Численность');
legend('Хищники (x)', 'Жертвы (y)');
title('Стационарное состояние системы');
xgrid();

// График 2: Фазовый портрет (стационарная точка)
figure(2);
plot(xy(1,:), xy(2,:), 'bo', 'MarkerSize', 8);
xlabel('Хищники (x)');
ylabel('Жертвы (y)');
title('Стационарная точка на фазовой плоскости');
xgrid();
