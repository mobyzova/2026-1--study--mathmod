// Модель "хищник-жертва" - Вариант 60

a = 0.43;
b = 0.061;
c = 0.47;
d = 0.059;

function dx = syst2(t, xy)
    dx(1) = -a*xy(1) + b*xy(1)*xy(2);
    dx(2) = c*xy(2) - d*xy(1)*xy(2);
endfunction

t0 = 0;
xy0 = [8; 24];
t = [0:0.1:400];

xy = ode(xy0, t0, t, syst2);

// Создаем новый график
figure(1);

// График x(t) и y(t) на одном рисунке
plot(t, xy(1,:), 'r-', t, xy(2,:), 'g-');
xlabel('Время t');
ylabel('Численность');
legend('Хищники (x)', 'Жертвы (y)');
title('Динамика численности хищников и жертв');
xgrid();

// Фазовый портрет
figure(2);
plot(xy(1,:), xy(2,:), 'b-');
xlabel('Хищники (x)');
ylabel('Жертвы (y)');
title('Фазовый портрет');
xgrid();
